# Copy to .env and adjust. Never commit the real .env.

# --- Database (defaults match docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=healthnet_root
MYSQL_DATABASE=healthnetstorage
MYSQL_USER=healthnet
MYSQL_PASSWORD=healthnet_pass

# --- Backend datasource ---
# Host port 3307 maps to the container's 3306 (see docker-compose.yml).
DB_URL="jdbc:mysql://localhost:3307/healthnetstorage?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME=healthnet
DB_PASSWORD=healthnet_pass

PORT=8081

# --- JWT ---
# Base64-encoded HMAC-SHA256 key. Without this a new key is generated on every
# restart, logging everyone out. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# --- AI query service ---
# The original service is gone. Leave AI_ENABLED=false to have chat endpoints
# return a clear "unavailable" message; set the URL and flip to true to attach
# a replacement that accepts POST {query, role, patient_id, doctor_id, model}
# and returns {"response": "..."}.
# The old service exposed /api/query (chat), /api/medical-advice and /api/email
# (daily suggestions). AI_BASE_URL covers all three; AI_URL overrides just chat.
AI_ENABLED=false
AI_BASE_URL=http://localhost:7898
AI_TIMEOUT_MS=60000
